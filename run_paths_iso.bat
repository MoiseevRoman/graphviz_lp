@echo off
REM ================================================================
REM  ISO-TOKEN EXPERIMENT: image vs text at the SAME token budget.
REM
REM  Image 560x560 = 400 visual tokens in Qwen2.5-VL. Question: can a
REM  picture pack MORE graph structure into 400 tokens than text can?
REM  To give the image room to win, the subgraph is DENSE:
REM    20 candidates x up to 5 two-hop paths, edges WITHOUT relation
REM    labels (same for image and text), intermediates as points/x1..
REM  Full edge list: median ~540 tokens, p95 ~1400 (does not fit 400).
REM
REM  LEAK-FREE: candidate pool for the context = top-50 tails of the
REM  relation by train frequency, gold is NOT appended (it is appended
REM  only for rank scoring, as before). Gold is among the 20 shown
REM  candidates only if it is there on its own merits.
REM
REM  Conditions (scripts\viability_gate.py --context_mode):
REM    text_paths_iso  edge list cut to <=400 tokens (ISO-TOKEN text):
REM                    all candidates + paths round-robin (1st path of
REM                    every candidate, then 2nd, ...) until budget
REM    visual_paths    image of the full dense subgraph (400 vis. tok)
REM    both_paths_iso  image + the 400-token text
REM    text_paths      full edge list (ISO-INFORMATION, cap 1800 tok,
REM                    hits ~2 pct of queries)
REM    text_cn         path counts per candidate, full graph (~210 tok)
REM    none            query only (reused from graphvis_ckpts_paths if
REM                    present: same triples, same prompt, no context)
REM  visual_paths / both_paths_iso are also evaluated with a BLANK image.
REM
REM  Read-out:
REM    visual_paths   vs text_paths_iso  -> modality at equal tokens
REM    both_paths_iso vs text_paths_iso  -> does the image add anything
REM                                         beyond the budgeted text
REM    visual_paths   vs text_paths      -> modality at equal info
REM    *_real vs *_blank                 -> is the image used at all
REM
REM  Protocol as in the paper: Qwen2.5-VL-3B, QLoRA, 4000 train ex,
REM  1 epoch, rank eval on the same 1000 seed-sampled queries (971),
REM  cand_cap=50, max_length=2048 for all conditions.
REM  Writes only into graphvis_ckpts_paths_iso\ . ~2.5-3 h per
REM  condition. Finished conditions are skipped on re-run.
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_paths_iso.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

REM -- parameters --
set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set DATA_ROOT=graphvis_paths_iso
set DS=%DATA_ROOT%\datasets
set CK=graphvis_ckpts_paths_iso
set LOGDIR=%CK%\logs
set TRAIN_N=4000
set EVAL_N=1000
set MAXLEN=2048
set BUILD=--n_show 20 --max_paths 5 --no-label_edges --text_budget 400 --full_budget 1800 --preselect cn_freq --cand_cap 50 --workers 4 --out_root %DATA_ROOT%

if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  ISO-TOKEN BLOCK START: %DATE% %TIME%
echo  python = %PYTHON%
echo  data   = %DS%
echo  ckpts  = %CK%
echo  train_n=%TRAIN_N%  eval_n=%EVAL_N%  max_length=%MAXLEN%
echo ================================================================

REM ---------- 1) dataset (normally already built) ----------
if exist "%DS%\stage2_test" (
  echo [%TIME%] test split exists: %DS%\stage2_test
) else (
  echo [%TIME%] BUILD test split ^(2000 rows^) -^> %DS%\stage2_test
  %PYTHON% scripts\build_path_dataset.py --splits stage2_test --limit 2000 %BUILD% > "%LOGDIR%\build_test.log" 2>&1
  if errorlevel 1 ( echo [X] test build FAILED - see %LOGDIR%\build_test.log & goto END )
)
if exist "%DS%\stage2_train" (
  echo [%TIME%] train split exists: %DS%\stage2_train
) else (
  echo [%TIME%] BUILD train split -^> %DS%\stage2_train
  %PYTHON% scripts\build_path_dataset.py --splits stage2_train %BUILD% > "%LOGDIR%\build_train.log" 2>&1
  if errorlevel 1 ( echo [X] train build FAILED - see %LOGDIR%\build_train.log & goto END )
)

REM -- baseline VRAM (free threshold = baseline + 800 MiB) --
set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800
echo Baseline VRAM: %BASE% MiB  (between runs wait until below %THRESH% MiB)
echo.

REM ---------- 2) none: reuse (context-free, identical to path block) ----------
if not exist "%CK%\ctx_none\report.json" if exist "graphvis_ckpts_paths\ctx_none\report.json" (
  echo [%TIME%] none: reusing graphvis_ckpts_paths\ctx_none ^(same triples, no context^)
  mkdir "%CK%\ctx_none" 2>nul
  copy /y "graphvis_ckpts_paths\ctx_none\*.json" "%CK%\ctx_none\" >nul
)

REM ---------- 3) train + eval per condition ----------
REM  most informative first: if interrupted, the key pair is done.
call :RUN text_paths_iso "real"
call :RUN visual_paths   "real,blank"
call :RUN both_paths_iso "real,blank"
call :RUN text_paths     "real"
call :RUN text_cn        "real"
call :RUN none           "real"

REM  blank-image details -> ctx_<cond>_blank so they can be compared
call :BLANKCOPY visual_paths
call :BLANKCOPY both_paths_iso

REM ---------- 4) summaries (paired bootstrap + McNemar) ----------
echo [%TIME%] SUMMARY vs text_paths_iso (same token budget)
%PYTHON% scripts\compare_conditions.py --ckpt_root %CK% --conditions text_paths_iso,visual_paths,both_paths_iso,text_paths,text_cn,none --baseline text_paths_iso --out %CK%\compare_vs_text_iso.json > "%LOGDIR%\compare_vs_text_iso.log" 2>&1
type "%LOGDIR%\compare_vs_text_iso.log"
echo [%TIME%] SUMMARY vs text_paths (same information)
%PYTHON% scripts\compare_conditions.py --ckpt_root %CK% --conditions text_paths,visual_paths,both_paths_iso,text_paths_iso --baseline text_paths --out %CK%\compare_vs_text_full.json > "%LOGDIR%\compare_vs_text_full.log" 2>&1
type "%LOGDIR%\compare_vs_text_full.log"
echo [%TIME%] SUMMARY vs none
%PYTHON% scripts\compare_conditions.py --ckpt_root %CK% --conditions none,text_cn,text_paths_iso,text_paths,visual_paths,both_paths_iso --baseline none --out %CK%\compare_vs_none.json > "%LOGDIR%\compare_vs_none.log" 2>&1
type "%LOGDIR%\compare_vs_none.log"
echo [%TIME%] SUMMARY real vs blank image
%PYTHON% scripts\compare_conditions.py --ckpt_root %CK% --conditions visual_paths_blank,visual_paths,both_paths_iso_blank,both_paths_iso,text_paths_iso --baseline visual_paths_blank --out %CK%\compare_blank.json > "%LOGDIR%\compare_blank.log" 2>&1
type "%LOGDIR%\compare_blank.log"

:END
echo ================================================================
echo  DONE: %DATE% %TIME%
echo    reports: %CK%\ctx_^<cond^>\report.json
echo    paired:  %CK%\compare_vs_text_iso.json (main), compare_vs_text_full.json,
echo             compare_vs_none.json, compare_blank.json
echo    logs:    %LOGDIR%\
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:RUN
REM  %1 = context_mode  %2 = image_modes for eval (QUOTED: comma!)
set CD=%~1
set IM=%~2
if exist "%CK%\ctx_%CD%\report.json" (
  echo [%TIME%] %CD%: report exists - skip
  goto :eof
)
echo [%TIME%] TRAIN+EVAL context=%CD%  image_modes=%IM%  (log: %LOGDIR%\train_%CD%.log)
%PYTHON% scripts\viability_gate.py --model %MODEL% --context_mode %CD% --train_vision --dataset_root %DS% --data_dir FB15k-237 --train_n %TRAIN_N% --eval_n %EVAL_N% --epochs 1 --eval_mode rank --cand_cap 50 --image_modes "%IM%" --max_length %MAXLEN% --output_dir %CK%\ctx_%CD% --out %CK%\ctx_%CD%\report.json > "%LOGDIR%\train_%CD%.log" 2>&1
echo [%TIME%] %CD% done (code=%ERRORLEVEL%)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof

:BLANKCOPY
set CD=%~1
if not exist "%CK%\ctx_%CD%\test_details_rank_blank.json" (
  echo [!] no blank-image eval for %CD%
  goto :eof
)
if not exist "%CK%\ctx_%CD%_blank" mkdir "%CK%\ctx_%CD%_blank"
copy /y "%CK%\ctx_%CD%\test_details_rank_blank.json" "%CK%\ctx_%CD%_blank\" >nul
copy /y "%CK%\ctx_%CD%\test_metrics_rank_blank.json" "%CK%\ctx_%CD%_blank\" >nul 2>&1
goto :eof
