@echo off
REM ================================================================
REM  TWO-STAGE K=16 WITH REPLAY (stage-1 reading data mixed into LP).
REM  Follow-up to run_stage1_k16.bat. There, LP training after stage 1
REM  wiped the reading skill (probe stage1_lp = 0) and real = blank
REM  image (MRR 0.3875 vs 0.3887). Standard fix (LLaVA-1.5, Qwen-VL):
REM  keep earlier-stage tasks in the later-stage mix.
REM
REM  Stage 2 starts from the SAME stage-1 adapter
REM  (graphvis_ckpts_s1\k16\ctx_visual_s1\adapter_stage1, already
REM  trained, not repeated) and trains on 4000 LP examples (the same
REM  as before) + 1000 random stage-1 reading examples, shuffled,
REM  1 epoch. Everything else is identical to ctx_visual_s1 / the
REM  one-stage baseline ctx_visual_vbf16: --train_vision
REM  --vision_bf16, rank eval_n=1000 (971 queries), cand_cap=50,
REM  real + blank image.
REM
REM  Steps (finished ones are skipped on re-run):
REM    1 LP + replay train + eval real/blank   ~5.5 h
REM    2 reading probe of the final adapter    ~20 min
REM    3 paired comparison                     ~1 min
REM  Total ~6 h.
REM
REM  Output: graphvis_ckpts_s1\k16\
REM    ctx_visual_s1rp\adapter\       final adapter + report.json
REM    read_probe.json                + point "s1rp_lp"
REM    compare_rp.json, compare_rp_blank.json, compare_rp_vs_s1.json
REM  Nothing existing is changed (baselines are COPIED, json only).
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_stage1_replay_k16.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set DS=graphvis_scaling\k16\datasets
set OUT=graphvis_ckpts_s1\k16
set S1DS=%OUT%\stage1_drawn
set S1A=%OUT%\ctx_visual_s1\adapter_stage1
set RD=%OUT%\ctx_visual_s1rp
set REPLAY_N=1000
set PROBE=%OUT%\read_probe.json
set LOGDIR=%OUT%\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  STAGE1 + REPLAY x K=16 START: %DATE% %TIME%
echo  python = %PYTHON%
echo  out    = %RD%
echo ================================================================

if not exist "%DS%\stage2_train" ( echo [X] no dataset %DS% & goto END )
if not exist "%S1DS%\dataset_info.json" ( echo [X] no stage-1 set %S1DS% - run run_stage1_k16.bat first & goto END )
if not exist "%S1A%\adapter_model.safetensors" ( echo [X] no stage-1 adapter %S1A% - run run_stage1_k16.bat first & goto END )

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

REM ---------- 1) LP + replay from the stage-1 adapter -> eval ----------
set ARGS=--model %MODEL% --context_mode visual --train_vision --vision_bf16 --dataset_root %DS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %RD%
if exist "%RD%\report.json" goto TRAINED
if exist "%RD%\adapter\adapter_model.safetensors" (
  set IMS=real,blank
  if exist "%RD%\test_details_rank.json" set IMS=blank
  echo [%TIME%] adapter found - EVAL ONLY image_modes=!IMS!  ^(log: %LOGDIR%\eval_rp.log^)
  %PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %RD%\adapter %ARGS% --image_modes "!IMS!" --out %RD%\report.json > "%LOGDIR%\eval_rp.log" 2>&1
) else (
  echo [%TIME%] TRAIN LP + replay %REPLAY_N%, then EVAL  ^(log: %LOGDIR%\train_rp.log^)
  %PYTHON% scripts\viability_gate.py %ARGS% --init_adapter %S1A% --replay_dir %S1DS% --replay_n %REPLAY_N% --train_n 4000 --epochs 1 --image_modes "real,blank" --out %RD%\report.json > "%LOGDIR%\train_rp.log" 2>&1
)
echo [%TIME%] done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
:TRAINED

REM ---------- 2) reading probe of the final adapter ----------
if exist "%RD%\adapter\adapter_config.json" (
  echo [%TIME%] READ PROBE s1rp_lp  ^(log: %LOGDIR%\probe_s1rp_lp.log^)
  %PYTHON% scripts\star_read_probe.py --ks 16 --n 60 --quants vision_bf16 --label s1rp_lp --adapter "%RD%\adapter" --out %PROBE% > "%LOGDIR%\probe_s1rp_lp.log" 2>&1
  echo [%TIME%] probe done ^(code=!ERRORLEVEL!^)
) else (
  echo [!] no final adapter - probe skipped
)

REM ---------- 3) paired comparison (copies, json only) ----------
if not exist "%RD%\test_details_rank.json" (
  echo [!] no eval details - comparison skipped
  goto SUMMARY
)
if not exist "%OUT%\ctx_visual_s1rp_blank" mkdir "%OUT%\ctx_visual_s1rp_blank"
if exist "%RD%\test_details_rank_blank.json" copy /y "%RD%\test_details_rank_blank.json" "%OUT%\ctx_visual_s1rp_blank\" >nul
%PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_vbf16,visual_s1rp,visual_s1rp_blank,visual_s1,text,none --baseline visual_vbf16 --out %OUT%\compare_rp.json > "%LOGDIR%\compare_rp.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_s1rp_blank,visual_s1rp --baseline visual_s1rp_blank --out %OUT%\compare_rp_blank.json > "%LOGDIR%\compare_rp_blank.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_s1,visual_s1rp --baseline visual_s1 --out %OUT%\compare_rp_vs_s1.json > "%LOGDIR%\compare_rp_vs_s1.log" 2>&1

:SUMMARY
echo.
echo ================ SUMMARY ================
if exist "%LOGDIR%\compare_rp.log" type "%LOGDIR%\compare_rp.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"[skip]" /c:"Saved" /c:"json"
if exist "%LOGDIR%\compare_rp_blank.log" type "%LOGDIR%\compare_rp_blank.log" | findstr /l /c:"===" /c:"MRR ="
if exist "%LOGDIR%\probe_s1rp_lp.log" type "%LOGDIR%\probe_s1rp_lp.log" | findstr /l /c:"/K16/"

:END
echo ================================================================
echo  DONE: %DATE% %TIME%
echo    report: %RD%\report.json
echo    probe:  %PROBE%
echo    paired: %OUT%\compare_rp*.json
echo ================================================================
endlocal
pause
goto :EOF
