@echo off
REM ================================================================
REM  VISION TOWER WITHOUT 4-BIT QUANTIZATION
REM
REM  In all runs so far QLoRA quantized the WHOLE model to NF4,
REM  including the vision tower (ViT + merger). Text conditions do not
REM  use the vision tower, so this hits only the image. Here the vision
REM  tower is kept in bf16 (--vision_bf16), the LM stays in NF4.
REM  The loader checks this and FAILS if the tower is still 4-bit.
REM
REM  Step 1  READING PROBE (no training, ~1 h): base Qwen2.5-VL-3B is
REM          asked to list the 20 candidate names from the picture.
REM          renders: base  = as in the dataset (560 px, 400 vis. tok)
REM                   font  = 560 px, font x2.5 (same 400 tokens)
REM                   hires = 1120 px (~1600 tokens, resolution ceiling)
REM          quant:   nf4 (as before) vs vision_bf16
REM          -> graphvis_ckpts_paths_iso\label_probe.json
REM  Step 2  RETRAIN visual_paths with --vision_bf16 (~3 h), same data
REM          and protocol as graphvis_ckpts_paths_iso\ctx_visual_paths,
REM          evaluated with real and blank image.
REM          -> ctx_visual_paths_vbf16 ; compared with visual_paths (NF4)
REM             and text_paths_iso (same token budget)
REM
REM  If step 1 shows no gain from vision_bf16, step 2 can be skipped:
REM  close the window after step 1 (finished steps are skipped on re-run).
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_vision_bf16.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set DS=graphvis_paths_iso\datasets
set CK=graphvis_ckpts_paths_iso
set LOGDIR=%CK%\logs
set PROBE_DIR=graphvis_paths_iso\label_probe
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  VISION-BF16 BLOCK START: %DATE% %TIME%
echo  python = %PYTHON%
echo ================================================================

REM ---------- 1) reading probe ----------
if not exist "%PROBE_DIR%\manifest.json" (
  echo [%TIME%] render probe images -^> %PROBE_DIR%
  %PYTHON% scripts\label_read_probe.py prepare > "%LOGDIR%\label_probe_prepare.log" 2>&1
  if errorlevel 1 ( echo [X] probe prepare FAILED - see %LOGDIR%\label_probe_prepare.log & goto END )
)
if exist "%CK%\label_probe.done" (
  echo [%TIME%] reading probe done - skip
) else (
  echo [%TIME%] READING PROBE ^(log: %LOGDIR%\label_probe.log^)
  %PYTHON% scripts\label_read_probe.py run --n 60 --model %MODEL% --out %CK%\label_probe.json > "%LOGDIR%\label_probe.log" 2>&1
  if errorlevel 1 ( echo [X] probe FAILED - see %LOGDIR%\label_probe.log & goto END )
  echo done> "%CK%\label_probe.done"
)
type "%LOGDIR%\label_probe.log" | findstr /b /c:"===" /c:"quant/render" /c:"nf4/" /c:"vision_bf16/"
echo.

REM -- baseline VRAM (free threshold = baseline + 800 MiB) --
set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300

REM ---------- 2) retrain visual_paths with the vision tower in bf16 ----------
set CD=visual_paths_vbf16
if exist "%CK%\ctx_%CD%\report.json" (
  echo [%TIME%] %CD%: report exists - skip
) else (
  echo [%TIME%] TRAIN+EVAL visual_paths --vision_bf16 ^(log: %LOGDIR%\train_%CD%.log^)
  %PYTHON% scripts\viability_gate.py --model %MODEL% --context_mode visual_paths --train_vision --vision_bf16 --dataset_root %DS% --data_dir FB15k-237 --train_n 4000 --eval_n 1000 --epochs 1 --eval_mode rank --cand_cap 50 --image_modes "real,blank" --max_length 2048 --output_dir %CK%\ctx_%CD% --out %CK%\ctx_%CD%\report.json > "%LOGDIR%\train_%CD%.log" 2>&1
  echo [%TIME%] %CD% done ^(code=!ERRORLEVEL!^)
)
if exist "%CK%\ctx_%CD%\test_details_rank_blank.json" (
  if not exist "%CK%\ctx_%CD%_blank" mkdir "%CK%\ctx_%CD%_blank"
  copy /y "%CK%\ctx_%CD%\test_details_rank_blank.json" "%CK%\ctx_%CD%_blank\" >nul
)

REM ---------- 3) summaries ----------
echo [%TIME%] SUMMARY vision_bf16 vs NF4 vs text (same token budget)
%PYTHON% scripts\compare_conditions.py --ckpt_root %CK% --conditions visual_paths,visual_paths_vbf16,visual_paths_vbf16_blank,text_paths_iso,none --baseline visual_paths --out %CK%\compare_vbf16.json > "%LOGDIR%\compare_vbf16.log" 2>&1
type "%LOGDIR%\compare_vbf16.log"

:END
echo ================================================================
echo  DONE: %DATE% %TIME%
echo    probe:   %CK%\label_probe.json  (log %LOGDIR%\label_probe.log)
echo    report:  %CK%\ctx_visual_paths_vbf16\report.json
echo    paired:  %CK%\compare_vbf16.json
echo ================================================================
endlocal
pause
goto :EOF
