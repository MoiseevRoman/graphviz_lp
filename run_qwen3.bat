@echo off
REM ================================================================
REM  SECOND MODEL: is visual < text specific to Qwen2.5-VL-3B?
REM
REM  The paper's main comparison (text vs visual neighborhood) is
REM  repeated with Qwen3-VL-4B-Instruct (newer ViT, DeepStack: visual
REM  features injected into 3 LM layers, not only at the input).
REM  Everything else is the paper's protocol:
REM    data   graphvis_scaling\k<K>\datasets (same renders, same text)
REM    train  4000 examples, 1 epoch, QLoRA r=64, --train_vision,
REM           max_length default (1024)
REM    eval   rank, eval_n=1000 (the same 971 common-test queries),
REM           cand_cap=50; visual also with a BLANK image
REM  Differences (forced by the model, same for all conditions):
REM    - vision tower in bf16 (--vision_bf16), LM in NF4. Our probe
REM      showed 4-bit hurts the image; this removes that objection.
REM    - Qwen3-VL uses 32 px per visual token (Qwen2.5: 28 px). The
REM      processor resizes the 560 px render to 640 px -> exactly 400
REM      visual tokens, as Qwen2.5 had with 560 px. The blank image
REM      is resized too -> also 400 tokens (real-blank is clean).
REM
REM  K = 16 only (the paper's main point; Qwen2.5 K4 ~ K16 anyway).
REM  Conditions:
REM    text    neighbors as text (baseline)
REM    visual  neighbors as image (real + blank image)
REM    none    query only
REM  Topology reading (same minimal-pair probe as run_topology_rta.bat,
REM  same 121 images, results go next to Qwen2.5 in cf_probe.json):
REM    q3_base   Qwen3 base model         (cf. base     for Qwen2.5)
REM    q3_lp     Qwen3 after LP (visual)  (cf. lp_vbf16 for Qwen2.5)
REM    drop   "box X?"         presence of a node
REM    swap   "arrow r to X?"  edge label bound to the right neighbor
REM    detach "X connected?"   adjacency (box drawn, arrow removed)
REM  Question: does Qwen3 also lose label binding after LP, and does it
REM  read adjacency better (DeepStack)?
REM  Qwen2.5 results are COPIED (json only) for side-by-side tables.
REM
REM  Output: graphvis_ckpts_qwen3\k16\
REM    ctx_text, ctx_visual, ctx_visual_blank, ctx_none   Qwen3 runs
REM    ctx_q25_text, ctx_q25_visual, ctx_q25_visual_vbf16,
REM    ctx_q25_none                                       Qwen2.5 copies
REM    compare.json         Qwen3: visual / none vs text (main question)
REM    compare_blank.json   Qwen3: real vs blank image (image used?)
REM    compare_models.json  Qwen3 vs Qwen2.5, same conditions
REM  Probe: graphvis_readcheck\cf_probe.json (labels q3_base, q3_lp)
REM
REM  Needs transformers>=4.57 (Qwen3-VL). Checked at start. First run
REM  downloads Qwen3-VL-4B (~9 GB). A short smoke run (16 examples,
REM  ~10 min) checks load / memory / eval before the long runs.
REM  Time ~13 h: text ~3.5, visual ~6 (2 evals), none ~3, probes ~0.5.
REM  Finished steps are skipped on re-run; if a run stopped after
REM  training, only the missing eval is redone.
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_qwen3.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen3-VL-4B-Instruct
set OUT=graphvis_ckpts_qwen3
set COMMON=graphvis_ckpts_scaling_common
set VBF=graphvis_ckpts_scaling_vbf16
set LOGDIR=%OUT%\logs
set PROBE=graphvis_readcheck\cf_probe.json
if not exist "%LOGDIR%" mkdir "%LOGDIR%"
set COMMON_ARGS=--model %MODEL% --train_vision --vision_bf16 --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50

echo ================================================================
echo  QWEN3-VL BLOCK START: %DATE% %TIME%
echo  python = %PYTHON%
echo  model  = %MODEL%
echo  out    = %OUT%
echo ================================================================

REM ---------- 0) transformers must know Qwen3-VL ----------
%PYTHON% -c "import transformers as t; from transformers import Qwen3VLForConditionalGeneration; print('transformers', t.__version__, '- Qwen3-VL OK')"
if errorlevel 1 goto OLDTF

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800
echo Baseline VRAM: %BASE% MiB  (between runs wait until below %THRESH% MiB)
echo.

REM ---------- 1) smoke run: load, train 16 ex, eval 8 queries ----------
if exist "%OUT%\smoke.done" goto SMOKEOK
echo [%TIME%] SMOKE visual, 16 train / 8 eval  ^(log: %LOGDIR%\smoke.log^)
%PYTHON% scripts\viability_gate.py %COMMON_ARGS% --context_mode visual --dataset_root graphvis_scaling\k16\datasets --train_n 16 --eval_n 8 --epochs 1 --image_modes "real" --output_dir %OUT%\smoke --out %OUT%\smoke\report.json > "%LOGDIR%\smoke.log" 2>&1
if not exist "%OUT%\smoke\report.json" goto SMOKEFAIL
echo done> "%OUT%\smoke.done"
findstr /c:"trainable params" /c:"MRR" "%LOGDIR%\smoke.log"
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
:SMOKEOK
echo [%TIME%] smoke run OK
echo.

REM ---------- 2) probe of the BASE model (no training needed) ----------
if not exist "graphvis_cf\k16\probe_items.json" (
  echo [%TIME%] BUILD cf renders  ^(log: %LOGDIR%\cf_build.log^)
  %PYTHON% scripts\cf_read_probe.py build > "%LOGDIR%\cf_build.log" 2>&1
)
call :PROBE q3_base ""

REM ---------- 3) main runs, K=16 ----------
call :RUNK 16
call :RUN 16 none "real"

REM ---------- 4) probe after LP ----------
call :PROBE q3_lp %OUT%\k16\ctx_visual\adapter

REM ---------- 5) paired comparisons ----------
call :COMPARE 16

echo.
echo ================ SUMMARY ================
if exist "%LOGDIR%\compare_k16.log" (
  echo ---------------- Qwen3: vs text ----------------
  type "%LOGDIR%\compare_k16.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"Saved" /c:"json"
  echo ---------------- Qwen3 vs Qwen2.5 ----------------
  type "%LOGDIR%\compare_k16_models.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"Saved" /c:"json"
)
echo ---------------- topology probe: Qwen2.5 (base, lp_vbf16) vs Qwen3 (q3_*) ----------------
%PYTHON% scripts\cf_read_probe.py report --out %PROBE%
goto END

:OLDTF
echo.
echo [X] this transformers has no Qwen3-VL. Upgrade inside myenv, e.g.:
echo       pip install "transformers==4.57.6"
echo     then run this file again.
goto END

:SMOKEFAIL
echo [X] smoke run FAILED - see %LOGDIR%\smoke.log
echo     (CUDA out of memory: close other GPU programs and retry)
goto END

:END
echo ================================================================
echo  DONE: %DATE% %TIME%
echo    reports: %OUT%\k16\ctx_^<cond^>\report.json
echo    paired:  %OUT%\k16\compare*.json  (logs: %LOGDIR%\)
echo    probe:   %PROBE%
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:RUNK
REM  %1 = K : copies of Qwen2.5 results, then text and visual
set K=%~1
set KD=%OUT%\k%K%
if not exist "%KD%" mkdir "%KD%"
if not exist "%KD%\ctx_q25_none" if exist "graphvis_ckpts_s1\k16\ctx_none" (
  mkdir "%KD%\ctx_q25_none" 2>nul
  copy /y "graphvis_ckpts_s1\k16\ctx_none\test_details_rank*.json" "%KD%\ctx_q25_none\" >nul
)
for %%c in (text visual) do (
  if not exist "%KD%\ctx_q25_%%c\report.json" if exist "%COMMON%\k%K%\ctx_%%c\report.json" (
    mkdir "%KD%\ctx_q25_%%c" 2>nul
    copy /y "%COMMON%\k%K%\ctx_%%c\*.json" "%KD%\ctx_q25_%%c\" >nul
  )
)
call :RUN %K% text "real"
call :RUN %K% visual "real,blank"
goto :eof

:RUN
REM  %1 = K  %2 = context_mode  %3 = image_modes (QUOTED: comma!)
REM  resume: report.json = done; adapter without report = eval only
set K=%~1
set CD=%~2
set IM=%~3
set DS=graphvis_scaling\k%K%\datasets
set RD=%OUT%\k%K%\ctx_%CD%
if not exist "%DS%\stage2_train" (
  echo [!] K=%K%: no dataset %DS% - skip
  goto :eof
)
if exist "%RD%\report.json" (
  echo [%TIME%] K=%K% %CD%: report exists - skip
  goto RUN_DONE
)
set RUN_ARGS=%COMMON_ARGS% --context_mode %CD% --dataset_root %DS% --output_dir %RD%
if not exist "%RD%\adapter\adapter_model.safetensors" goto RUN_TRAIN
if exist "%RD%\test_details_rank.json" if "%IM%"=="real,blank" set IM=blank
echo [%TIME%] K=%K% %CD%: adapter found - EVAL ONLY image_modes=!IM!  ^(log: %LOGDIR%\eval_k%K%_%CD%.log^)
%PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %RD%\adapter %RUN_ARGS% --image_modes "!IM!" --out %RD%\report.json > "%LOGDIR%\eval_k%K%_%CD%.log" 2>&1
echo [%TIME%] K=%K% %CD% eval done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto RUN_DONE
:RUN_TRAIN
echo [%TIME%] K=%K% %CD%: TRAIN+EVAL image_modes=%IM%  ^(log: %LOGDIR%\train_k%K%_%CD%.log^)
%PYTHON% scripts\viability_gate.py %RUN_ARGS% --train_n 4000 --epochs 1 --image_modes "%IM%" --out %RD%\report.json > "%LOGDIR%\train_k%K%_%CD%.log" 2>&1
echo [%TIME%] K=%K% %CD% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
:RUN_DONE
if not exist "%RD%\report.json" echo [!] K=%K% %CD%: no report.json - see logs
if not "%CD%"=="visual" goto :eof
if exist "%RD%\test_details_rank_blank.json" (
  if not exist "%RD%_blank" mkdir "%RD%_blank"
  copy /y "%RD%\test_details_rank_blank.json" "%RD%_blank\" >nul
)
goto :eof

:COMPARE
REM  %1 = K
set K=%~1
set KD=%OUT%\k%K%
if not exist "%KD%\ctx_text\report.json" goto :eof
if not exist "%KD%\ctx_q25_visual_vbf16\report.json" if exist "%VBF%\k%K%\ctx_visual_vbf16\report.json" (
  mkdir "%KD%\ctx_q25_visual_vbf16" 2>nul
  copy /y "%VBF%\k%K%\ctx_visual_vbf16\*.json" "%KD%\ctx_q25_visual_vbf16\" >nul
)
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions text,visual,visual_blank,none --baseline text --out %KD%\compare.json > "%LOGDIR%\compare_k%K%.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual_blank,visual --baseline visual_blank --out %KD%\compare_blank.json > "%LOGDIR%\compare_k%K%_blank.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions q25_text,q25_visual,q25_visual_vbf16,q25_none,text,visual,none --baseline q25_text --out %KD%\compare_models.json > "%LOGDIR%\compare_k%K%_models.log" 2>&1
goto :eof

:PROBE
REM  %1 = label   %2 = adapter dir ("" = base model)
set PL=%~1
set PA=%~2
if not "%PA%"=="" if not exist "%PA%\adapter_model.safetensors" (
  echo [!] probe %PL%: no adapter %PA% - skipped
  goto :eof
)
set AARG=
if not "%PA%"=="" set AARG=--adapter %PA%
echo [%TIME%] PROBE %PL%  ^(log: %LOGDIR%\cf_probe_%PL%.log^)
%PYTHON% scripts\cf_read_probe.py run --model %MODEL% --label %PL% %AARG% --out %PROBE% > "%LOGDIR%\cf_probe_%PL%.log" 2>&1
echo [%TIME%] probe %PL% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof
