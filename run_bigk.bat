@echo off
REM ================================================================
REM  BUDGET REGIME: K = 32 and 64 (1-hop star, same hybrid ranking).
REM  Question: does the image beat text when the neighborhood grows
REM  and the image cost stays ~fixed?
REM
REM  Neighbors: 1-hop only, top-K by the same hybrid ranking as K<=16
REM  (K32 is a superset of K16). NO 2-hop fill: heads with fewer
REM  neighbors just get a smaller star (deg>=32: ~65%% of test heads,
REM  deg>=64: ~32%%).
REM  Render: --max_nodes K+2 (old default cap = 14 nodes!).
REM    K=32: 560 px = 400 visual tokens  (text ~500 tokens)
REM    K=64: 728 px = 676 visual tokens  (text ~1000 tokens;
REM          560 px is unreadable at 64 nodes, 728 is near the
REM          Qwen max_pixels cap of 720 tokens)
REM  Conditions per K (4000 train x 1 epoch, rank eval 1000 -> 971
REM  common queries, cand_cap 50):
REM    visual_vbf16  image, --train_vision --vision_bf16, real+blank
REM    text          full neighbor list, --max_length 2048
REM    text_iso      text cut (whole edges, least relevant dropped)
REM                  to the image token budget (400 / 676)
REM  Reference copies (json only): none, text16, visual16 (K=16).
REM
REM  Needs Neo4j running (only for the dataset build step).
REM  Time: ~10-11 h per K (build ~0.5 h, 3 trainings ~3 h,
REM  4 evals ~7-8 h). Both K: ~21 h. Finished steps are skipped on
REM  re-run (resume after interruption is safe).
REM    run_bigk.bat        both K (32 first)
REM    run_bigk.bat 32     only K=32      run_bigk.bat 64   only K=64
REM
REM  Output: graphvis_scaling\k<K>\, graphvis_scaling\k<K>_textiso\
REM          graphvis_ckpts_bigk\k<K>\ctx_*\, compare_*.json, logs\
REM  Nothing existing is changed.
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root.  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set OUT=graphvis_ckpts_bigk
set LOGDIR=%OUT%\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  BIG-K BUDGET RUN START: %DATE% %TIME%
echo  python = %PYTHON%
echo  out    = %OUT%
echo ================================================================

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

if "%~1"=="" (
  call :RUNK 32 560 400
  call :RUNK 64 728 676
) else if "%~1"=="32" (
  call :RUNK 32 560 400
) else if "%~1"=="64" (
  call :RUNK 64 728 676
) else (
  echo [X] unknown argument %~1 - use 32, 64 or nothing
)

echo.
echo ================ SUMMARY ================
for %%k in (32 64) do (
  if exist "%LOGDIR%\compare_k%%k.log" (
    echo ---------------- K=%%k ----------------
    type "%LOGDIR%\compare_k%%k.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"[skip]" /c:"json"
    type "%LOGDIR%\compare_k%%k_iso.log" | findstr /l /c:"===" /c:"MRR ="
    type "%LOGDIR%\compare_k%%k_blank.log" | findstr /l /c:"===" /c:"MRR ="
  )
)
echo ================================================================
echo  DONE: %DATE% %TIME%
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:RUNK
REM  %1 = K   %2 = render size px   %3 = text budget (= visual tokens)
set K=%~1
set SIZE=%~2
set BUD=%~3
set /a MAXN=%K%+2
set DS=graphvis_scaling\k%K%\datasets
set DSI=graphvis_scaling\k%K%_textiso\datasets
set KD=%OUT%\k%K%
if not exist "%KD%" mkdir "%KD%"
echo.
echo ---------------- K=%K%  (%SIZE% px, budget %BUD% tokens) ----------------

REM ---------- build datasets ----------
if exist "%DS%\stage2_test\dataset_info.json" goto K_HAVEDS
%PYTHON% scripts\check_neo4j.py
if errorlevel 1 (
  echo [X] Neo4j is not reachable - start it and re-run. K=%K% skipped.
  goto :eof
)
echo [%TIME%] BUILD K=%K%  ^(log: %LOGDIR%\build_k%K%.log^)
%PYTHON% scripts\rerender_dataset.py --method hybrid --k %K% --target_size %SIZE% --max_nodes %MAXN% --splits stage2_train,stage2_test --limit 4000 --workers 4 --out_root graphvis_scaling\k%K% > "%LOGDIR%\build_k%K%.log" 2>&1
echo [%TIME%] build done ^(code=!ERRORLEVEL!^)
if not exist "%DS%\stage2_test\dataset_info.json" (
  echo [X] K=%K%: build failed - see %LOGDIR%\build_k%K%.log
  goto :eof
)
:K_HAVEDS
type "%DS%\metadata.json" | findstr /l /c:"dropped"
if not exist "%DSI%\stage2_test\dataset_info.json" (
  echo [%TIME%] TEXT BUDGET %BUD% tokens  ^(log: %LOGDIR%\textiso_k%K%.log^)
  %PYTHON% scripts\make_text_budget.py --src %DS% --out %DSI% --budget %BUD% > "%LOGDIR%\textiso_k%K%.log" 2>&1
  type "%LOGDIR%\textiso_k%K%.log" | findstr /l /c:"stage2_"
)

REM ---------- reference copies (json only) ----------
call :COPYREF none graphvis_ckpts_s1\k16\ctx_none
call :COPYREF text16 graphvis_ckpts_scaling_common\k16\ctx_text
call :COPYREF visual16 graphvis_ckpts_scaling_vbf16\k16\ctx_visual_vbf16

REM ---------- train + eval ----------
call :RUN visual_vbf16 %DS% "--context_mode visual --train_vision --vision_bf16" "real,blank"
call :RUN text_iso %DSI% "--context_mode text --train_vision --max_length 2048" "blank"
call :RUN text %DS% "--context_mode text --train_vision --max_length 2048" "blank"

REM ---------- paired comparisons ----------
if exist "%KD%\ctx_visual_vbf16\test_details_rank_blank.json" (
  if not exist "%KD%\ctx_visual_vbf16_blank" mkdir "%KD%\ctx_visual_vbf16_blank"
  copy /y "%KD%\ctx_visual_vbf16\test_details_rank_blank.json" "%KD%\ctx_visual_vbf16_blank\" >nul
)
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions text,text_iso,visual_vbf16,visual_vbf16_blank,none,text16,visual16 --baseline text --out %KD%\compare.json > "%LOGDIR%\compare_k%K%.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions text_iso,visual_vbf16 --baseline text_iso --out %KD%\compare_iso.json > "%LOGDIR%\compare_k%K%_iso.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual_vbf16_blank,visual_vbf16 --baseline visual_vbf16_blank --out %KD%\compare_blank.json > "%LOGDIR%\compare_k%K%_blank.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual16,visual_vbf16,text16,text --baseline visual16 --out %KD%\compare_vs16.json > "%LOGDIR%\compare_k%K%_vs16.log" 2>&1
goto :eof

:COPYREF
REM  %1 = condition name   %2 = source ctx dir
if exist "%KD%\ctx_%~1" goto :eof
if not exist "%~2" (
  echo [!] no reference %~2 - %~1 skipped
  goto :eof
)
mkdir "%KD%\ctx_%~1"
copy /y "%~2\test_details_rank*.json" "%KD%\ctx_%~1\" >nul
goto :eof

:RUN
REM  %1 = condition   %2 = dataset root   %3 = mode args   %4 = image modes
set RC=%~1
set RDS=%~2
set RA=%~3
set RIM=%~4
set RD=%KD%\ctx_%RC%
set RARGS=--model %MODEL% %RA% --dataset_root %RDS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %RD%
if exist "%RD%\report.json" (
  echo [%TIME%] K=%K% %RC%: done - skip
  goto :eof
)
if exist "%RD%\adapter\adapter_model.safetensors" (
  set IMS=%RIM%
  if "%RIM%"=="real,blank" if exist "%RD%\test_details_rank.json" set IMS=blank
  echo [%TIME%] K=%K% %RC%: adapter found - EVAL ONLY !IMS!  ^(log: %LOGDIR%\eval_k%K%_%RC%.log^)
  %PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %RD%\adapter %RARGS% --image_modes "!IMS!" --out %RD%\report.json > "%LOGDIR%\eval_k%K%_%RC%.log" 2>&1
) else (
  echo [%TIME%] K=%K% %RC%: TRAIN + EVAL  ^(log: %LOGDIR%\train_k%K%_%RC%.log^)
  %PYTHON% scripts\viability_gate.py %RARGS% --train_n 4000 --epochs 1 --image_modes "%RIM%" --out %RD%\report.json > "%LOGDIR%\train_k%K%_%RC%.log" 2>&1
)
echo [%TIME%] K=%K% %RC% finished ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof
