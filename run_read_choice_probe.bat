@echo off
REM ================================================================
REM  READING CHECK WITHOUT GENERATION, ALL K=16 POINTS.
REM  star_read_probe asks the model to LIST nodes/triples; after LP
REM  training the model answers with one line (format collapse), so
REM  that probe measures output format, not vision.
REM
REM  1) scripts\read_choice_probe.py: Yes/No questions, score =
REM     logit(Yes) - logit(No), metric = AUC (format-free).
REM       node      "is there a box 'X'?"  (neg = names from other images)
REM       edge_rel  "arrow 'r' between head and 'e'?" (neg = wrong drawn label)
REM       edge_ent  same positives vs an entity that is not drawn
REM     Image modes: real / shuffle (next query's image) / blank.
REM     READING = AUC(real) - AUC(shuffle), bootstrap 95% CI.
REM     100 images, ~2500 questions x 3 modes, ~15-25 min per point.
REM  2) LP rank eval with SHUFFLED image for s1fv and lp_only
REM     (eval only, ~80 min each): is real-blank gain = information
REM     from the image, or just "an image is present"?
REM
REM  Points: base, lp_only (vbf16), stage1, stage1_lp, s1rp_lp, s1fv_lp.
REM  Total ~4.5-5 h. Finished steps are skipped on re-run.
REM
REM  Output: graphvis_ckpts_s1\k16\
REM    read_choice_probe.json
REM    ctx_visual_s1fv_shuf\, ctx_visual_vbf16_shuf\   (shuffle eval)
REM    compare_shuf_fv.json, compare_shuf_vbf16.json
REM  Nothing existing is changed.
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_read_choice_probe.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set DS=graphvis_scaling\k16\datasets
set OUT=graphvis_ckpts_s1\k16
set VBF=graphvis_ckpts_scaling_vbf16\k16\ctx_visual_vbf16\adapter
set PROBE=%OUT%\read_choice_probe.json
set LOGDIR=%OUT%\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  READ CHOICE PROBE x K=16 START: %DATE% %TIME%
echo  python = %PYTHON%
echo ================================================================

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

REM ---------- 1) Yes/No reading probe, all points ----------
call :CHOICE base ""
call :CHOICE lp_only "%VBF%"
call :CHOICE stage1 "%OUT%\ctx_visual_s1\adapter_stage1"
call :CHOICE stage1_lp "%OUT%\ctx_visual_s1\adapter"
call :CHOICE s1rp_lp "%OUT%\ctx_visual_s1rp\adapter"
call :CHOICE s1fv_lp "%OUT%\ctx_visual_s1fv\adapter"

REM ---------- 2) LP rank eval with shuffled image ----------
call :SHUF visual_s1fv_shuf "%OUT%\ctx_visual_s1fv\adapter"
call :SHUF visual_vbf16_shuf "%VBF%"

if exist "%OUT%\ctx_visual_s1fv_shuf\test_details_rank_shuffle.json" (
  %PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_s1fv_shuf,visual_s1fv_blank,visual_s1fv --baseline visual_s1fv_shuf --out %OUT%\compare_shuf_fv.json > "%LOGDIR%\compare_shuf_fv.log" 2>&1
)
if exist "%OUT%\ctx_visual_vbf16_shuf\test_details_rank_shuffle.json" (
  %PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_vbf16_shuf,visual_vbf16_blank,visual_vbf16 --baseline visual_vbf16_shuf --out %OUT%\compare_shuf_vbf16.json > "%LOGDIR%\compare_shuf_vbf16.log" 2>&1
)

echo.
echo ================ SUMMARY ================
if exist "%LOGDIR%\choice_s1fv_lp.log" type "%LOGDIR%\choice_s1fv_lp.log" | findstr /l /c:"/K16 "
for %%f in (compare_shuf_fv compare_shuf_vbf16) do (
  if exist "%LOGDIR%\%%f.log" type "%LOGDIR%\%%f.log" | findstr /l /c:"===" /c:"MRR ="
)

echo ================================================================
echo  DONE: %DATE% %TIME%
echo    probe:   %PROBE%
echo    paired:  %OUT%\compare_shuf_*.json
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:CHOICE
REM  %1 = label   %2 = adapter dir ("" = base model)
set PL=%~1
set PA=%~2
if not "%PA%"=="" if not exist "%PA%\adapter_config.json" (
  echo [!] no adapter %PA% - %PL% skipped
  goto :eof
)
echo [%TIME%] CHOICE PROBE %PL%  ^(log: %LOGDIR%\choice_%PL%.log^)
if "%PA%"=="" (
  %PYTHON% scripts\read_choice_probe.py --label %PL% --out %PROBE% > "%LOGDIR%\choice_%PL%.log" 2>&1
) else (
  %PYTHON% scripts\read_choice_probe.py --label %PL% --adapter "%PA%" --out %PROBE% > "%LOGDIR%\choice_%PL%.log" 2>&1
)
echo [%TIME%] probe %PL% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof

:SHUF
REM  %1 = condition name (dir ctx_%1)   %2 = adapter dir
set SC=%~1
set SA=%~2
set SD=%OUT%\ctx_%SC%
if exist "%SD%\test_details_rank_shuffle.json" goto :eof
if not exist "%SA%\adapter_config.json" (
  echo [!] no adapter %SA% - %SC% skipped
  goto :eof
)
echo [%TIME%] LP EVAL shuffle %SC%  ^(log: %LOGDIR%\eval_%SC%.log^)
%PYTHON% scripts\viability_gate.py --eval_only --adapter_dir "%SA%" --model %MODEL% --context_mode visual --train_vision --vision_bf16 --dataset_root %DS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %SD% --image_modes shuffle --out %SD%\report.json > "%LOGDIR%\eval_%SC%.log" 2>&1
echo [%TIME%] eval %SC% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof
