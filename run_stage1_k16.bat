@echo off
REM ================================================================
REM  TWO-STAGE TRAINING AT K=16 (vision tower bf16) + READING PROBES.
REM  Question: does a graph-reading stage (stage 1) before link
REM  prediction make the model read the image better, and does that
REM  reach the answer?  Fair re-test of block 3, which used K=8,
REM  672 px, NF4 tower, half the link-prediction training, and never
REM  measured reading.
REM
REM  Matched to graphvis_ckpts_scaling_vbf16\k16\ctx_visual_vbf16
REM  (the one-stage baseline, MRR 0.398): same data, --train_vision
REM  --vision_bf16, LP 4000 examples x 1 epoch, rank eval_n=1000 (971
REM  common queries), cand_cap=50, real + blank image. The ONLY change
REM  is stage 1 before LP.
REM
REM  Stage 1 data (scripts\build_stage1_from_stage2.py --drawn):
REM    2500 random train graphs x 3 tasks (node_count, node_listing,
REM    triple_listing) ~ 7500 examples, 1 epoch. Targets = what is
REM    DRAWN (renderer node cap, truncated labels) - without --drawn,
REM    K=16 targets would list neighbours that are not on the image.
REM
REM  Reading probe (scripts\star_read_probe.py, 60 TEST images, K=16,
REM  tower bf16) at four points: base model, one-stage LP adapter
REM  (control), after stage 1, after stage 1 + LP. Tasks: names / triples (neutral wording) and
REM  s1_nodes / s1_triples (stage-1 wording). Recall and precision
REM  of entity names and of (relation, entity) pairs.
REM
REM  Steps (finished ones are skipped on re-run):
REM    1 build stage-1 set                 ~10 min (CPU)
REM    2 probe base model + one-stage LP   ~40 min
REM    3 stage 1 + LP train + eval         ~6 h (s1 2h, LP 1h, eval 3.4h)
REM    4 probe after stage 1, after LP     ~40 min
REM    5 paired comparison vs one-stage
REM  Total ~8 h.
REM
REM  Output: graphvis_ckpts_s1\k16\
REM    stage1_drawn\                   stage-1 dataset
REM    ctx_visual_s1\adapter_stage1\   adapter after stage 1
REM    ctx_visual_s1\adapter\          final adapter + report.json
REM    read_probe.json                 reading recall/precision (4 points)
REM    compare.json, compare_blank.json
REM  Nothing existing is changed (baselines are COPIED, json only).
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_stage1_k16.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set DS=graphvis_scaling\k16\datasets
set OUT=graphvis_ckpts_s1\k16
set S1DS=%OUT%\stage1_drawn
set VD=%OUT%\ctx_visual_s1
set VBF=graphvis_ckpts_scaling_vbf16\k16
set PROBE=%OUT%\read_probe.json
set LOGDIR=%OUT%\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  STAGE1 x K=16 START: %DATE% %TIME%
echo  python = %PYTHON%
echo  out    = %OUT%
echo ================================================================

if not exist "%DS%\stage2_train" (
  echo [X] no dataset %DS% - aborting
  goto END
)

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

REM ---------- 1) stage-1 dataset (targets = what is drawn) ----------
if exist "%S1DS%\dataset_info.json" (
  echo [%TIME%] stage-1 set exists - skip
) else (
  echo [%TIME%] BUILD stage-1 set  ^(log: %LOGDIR%\build_stage1.log^)
  %PYTHON% scripts\build_stage1_from_stage2.py --stage2 %DS%\stage2_train --out %S1DS% --graphs 2500 --tasks node_count,node_listing,triple_listing --degree_samples 0 --drawn > "%LOGDIR%\build_stage1.log" 2>&1
  if errorlevel 1 ( echo [X] build FAILED - see %LOGDIR%\build_stage1.log & goto END )
  type "%LOGDIR%\build_stage1.log" | findstr /l /c:"stage1" /c:"Graph"
)

REM ---------- 2) reading probe: base model, and the ONE-STAGE LP adapter ----------
REM  (control: does LP fine-tuning alone change reading?)
call :PROBE base ""
if exist "%VBF%\ctx_visual_vbf16\adapter\adapter_config.json" call :PROBE lp_only "%VBF%\ctx_visual_vbf16\adapter"

REM ---------- 3) stage 1 -> LP training -> eval (real + blank) ----------
set ARGS=--model %MODEL% --context_mode visual --train_vision --vision_bf16 --dataset_root %DS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %VD%
if exist "%VD%\report.json" goto TRAINED
if exist "%VD%\adapter\adapter_model.safetensors" (
  set IMS=real,blank
  if exist "%VD%\test_details_rank.json" set IMS=blank
  echo [%TIME%] adapter found - EVAL ONLY image_modes=!IMS!  ^(log: %LOGDIR%\eval.log^)
  %PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %VD%\adapter %ARGS% --image_modes "!IMS!" --out %VD%\report.json > "%LOGDIR%\eval.log" 2>&1
) else (
  echo [%TIME%] TRAIN stage1 + LP, then EVAL  ^(log: %LOGDIR%\train.log^)
  %PYTHON% scripts\viability_gate.py %ARGS% --with_stage1 --stage1_dir %S1DS% --stage1_epochs 1 --train_n 4000 --epochs 1 --image_modes "real,blank" --out %VD%\report.json > "%LOGDIR%\train.log" 2>&1
)
echo [%TIME%] done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
:TRAINED

REM ---------- 4) reading probe after stage 1 and after LP ----------
if exist "%VD%\adapter_stage1\adapter_config.json" (
  call :PROBE stage1 "%VD%\adapter_stage1"
) else (
  echo [!] no adapter_stage1 - probe after stage 1 skipped
)
if exist "%VD%\adapter\adapter_config.json" (
  call :PROBE stage1_lp "%VD%\adapter"
) else (
  echo [!] no final adapter - probe after LP skipped
)

REM ---------- 5) paired comparison vs one-stage (copies, json only) ----------
if not exist "%VD%\test_details_rank.json" (
  echo [!] no eval details - comparison skipped
  goto SUMMARY
)
if not exist "%OUT%\ctx_visual_s1_blank" mkdir "%OUT%\ctx_visual_s1_blank"
if exist "%VD%\test_details_rank_blank.json" copy /y "%VD%\test_details_rank_blank.json" "%OUT%\ctx_visual_s1_blank\" >nul
for %%c in (text visual visual_vbf16 visual_vbf16_blank) do (
  if exist "%VBF%\ctx_%%c" (
    if not exist "%OUT%\ctx_%%c" mkdir "%OUT%\ctx_%%c"
    copy /y "%VBF%\ctx_%%c\test_details_rank*.json" "%OUT%\ctx_%%c\" >nul
  )
)
if not exist "%OUT%\ctx_none" mkdir "%OUT%\ctx_none"
copy /y "graphvis_ckpts_paths\ctx_none\test_details_rank*.json" "%OUT%\ctx_none\" >nul
%PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_vbf16,visual_s1,visual_s1_blank,text,none --baseline visual_vbf16 --out %OUT%\compare.json > "%LOGDIR%\compare.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %OUT% --conditions visual_s1_blank,visual_s1 --baseline visual_s1_blank --out %OUT%\compare_blank.json > "%LOGDIR%\compare_blank.log" 2>&1

:SUMMARY
echo.
echo ================ SUMMARY ================
if exist "%LOGDIR%\compare.log" type "%LOGDIR%\compare.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"[skip]" /c:"Saved" /c:"json"
if exist "%LOGDIR%\compare_blank.log" type "%LOGDIR%\compare_blank.log" | findstr /l /c:"===" /c:"MRR ="
for %%p in (base lp_only stage1 stage1_lp) do (
  if exist "%LOGDIR%\probe_%%p.log" type "%LOGDIR%\probe_%%p.log" | findstr /l /c:"/K16/"
)

:END
echo ================================================================
echo  DONE: %DATE% %TIME%
echo    report:  %VD%\report.json
echo    probe:   %PROBE%
echo    paired:  %OUT%\compare.json, %OUT%\compare_blank.json
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:PROBE
REM  %1 = label   %2 = adapter dir ("" = base model)
set PL=%~1
set PA=%~2
echo [%TIME%] READ PROBE %PL%  ^(log: %LOGDIR%\probe_%PL%.log^)
if "%PA%"=="" (
  %PYTHON% scripts\star_read_probe.py --ks 16 --n 60 --quants vision_bf16 --label %PL% --out %PROBE% > "%LOGDIR%\probe_%PL%.log" 2>&1
) else (
  %PYTHON% scripts\star_read_probe.py --ks 16 --n 60 --quants vision_bf16 --label %PL% --adapter "%PA%" --out %PROBE% > "%LOGDIR%\probe_%PL%.log" 2>&1
)
echo [%TIME%] probe %PL% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof
