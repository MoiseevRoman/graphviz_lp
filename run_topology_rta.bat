@echo off
REM ================================================================
REM  TOPOLOGY READING + READ-THEN-ANSWER, K=16 (two tests in one run).
REM
REM  PART A. Counterfactual reading probe (minimal pairs, ~45 min).
REM   Same image, ONE edit; negatives are TRUE KG neighbors of the head,
REM   so the model cannot answer from memory:
REM     drop    ~30%% of neighbors invisible   "box X?"        kept vs dropped
REM     swap    labels of two edges swapped   "arrow r to X?"  new vs old pairs
REM     detach  arrow invisible, box stays    "X connected?"  attached vs detached
REM   Reading = AUC(edited) - AUC(original). Memory-only ~0,
REM   perfect reader: drop/detach ~+0.5, swap ~+1.
REM   Models: base, LP visual vbf16, s1fv, s1 (blind control).
REM
REM  PART B. Read-then-answer (RTA, ~10-12 h).
REM   LP target = drawn edges ("Edges: - rel -> ent ...") + "Answer: <tail>",
REM   so reading is part of the LP loss. At eval the reading is generated
REM   first, then candidates are ranked after "Answer:".
REM     B1 train RTA (4000, 1 epoch) + rank eval on 971 common queries
REM     B2 paired compare vs none / text / visual vbf16
REM     B3 counterfactual LP: 297 queries, ~30%% of neighbors removed from
REM        image AND text; text / visual / RTA on orig300 vs drop300
REM     B4 reading probe (part A) for the RTA adapter
REM     B5 report
REM   RTA ~ text (0.412)   -> the image gap is a perception gap
REM   RTA ~ visual (0.398) -> read edges add nothing over the bag of names
REM
REM  Total ~11-13 h. No Neo4j (renders prebuilt in graphvis_cf\k16).
REM  Finished steps are skipped on re-run (safe to stop and resume).
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root.  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set DS=graphvis_scaling\k16\datasets
set KD=graphvis_ckpts_rta\k16
set RD=%KD%\ctx_visual_rta
set CF=graphvis_ckpts_cf\k16
set CFD=graphvis_cf\k16\datasets
set LOGDIR=%KD%\logs
set A_TEXT=graphvis_ckpts_scaling\k16\ctx_text\adapter
set A_VIS=graphvis_ckpts_scaling_vbf16\k16\ctx_visual_vbf16\adapter
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

set PROBE=graphvis_readcheck\cf_probe.json
echo ================================================================
echo  CF PROBE + READ-THEN-ANSWER START: %DATE% %TIME%
echo ================================================================

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

if not exist "%CFD%\drop300\stage2_test\dataset_info.json" (
  echo [%TIME%] BUILD cf renders  ^(log: %LOGDIR%\cf_build.log^)
  %PYTHON% scripts\cf_read_probe.py build > "%LOGDIR%\cf_build.log" 2>&1
)

REM ================= PART A: reading probe =================
call :PROBE base ""
call :PROBE lp_vbf16 %A_VIS%
call :PROBE s1fv graphvis_ckpts_s1\k16\ctx_visual_s1fv\adapter
call :PROBE s1 graphvis_ckpts_s1\k16\ctx_visual_s1\adapter
echo.
%PYTHON% scripts\cf_read_probe.py report --out %PROBE%
echo.

REM ================= PART B: read-then-answer =================
REM ---------- B1. train + eval RTA ----------
set VARGS=--model %MODEL% --context_mode visual --train_vision --vision_bf16 --read_then_answer --data_dir FB15k-237 --eval_mode rank --cand_cap 50
if exist "%RD%\report.json" (
  echo [%TIME%] RTA: done - skip
  goto COPY
)
if exist "%RD%\adapter\adapter_model.safetensors" (
  echo [%TIME%] RTA: adapter found - EVAL ONLY  ^(log: %LOGDIR%\eval_rta.log^)
  %PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %RD%\adapter %VARGS% --dataset_root %DS% --eval_n 1000 --image_modes real --output_dir %RD% --out %RD%\report.json > "%LOGDIR%\eval_rta.log" 2>&1
) else (
  echo [%TIME%] RTA: TRAIN + EVAL  ^(log: %LOGDIR%\train_rta.log^)
  %PYTHON% scripts\viability_gate.py %VARGS% --dataset_root %DS% --train_n 4000 --epochs 1 --eval_n 1000 --image_modes real --output_dir %RD% --out %RD%\report.json > "%LOGDIR%\train_rta.log" 2>&1
)
echo [%TIME%] RTA finished ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300

REM ---------- B2. compare on the 971 common queries ----------
:COPY
call :COPYREF none graphvis_ckpts_s1\k16\ctx_none
call :COPYREF text graphvis_ckpts_scaling_common\k16\ctx_text
call :COPYREF visual_vbf16 graphvis_ckpts_scaling_vbf16\k16\ctx_visual_vbf16
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual_rta,visual_vbf16,text,none --baseline visual_rta --out %KD%\compare_rta.json > "%LOGDIR%\compare_rta.log" 2>&1

REM ---------- B3. counterfactual LP (orig300 vs drop300) ----------
for %%S in (orig300 drop300) do (
  call :CFEVAL %%S text %A_TEXT% "--context_mode text --train_vision" blank
  call :CFEVAL %%S visual_vbf16 %A_VIS% "--context_mode visual --train_vision --vision_bf16" real
  call :CFEVAL %%S visual_rta %RD%\adapter "--context_mode visual --train_vision --vision_bf16 --read_then_answer" real
)

REM ---------- B4. counterfactual reading probe for RTA ----------
call :PROBE rta %RD%\adapter

REM ---------- B5. report ----------
%PYTHON% scripts\rta_report.py > "%LOGDIR%\rta_report.log" 2>&1

echo.
echo ================ SUMMARY ================
type "%LOGDIR%\compare_rta.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"[skip]" /c:"json"
echo.
type "%LOGDIR%\rta_report.log"
echo.
%PYTHON% scripts\cf_read_probe.py report --out %PROBE%
echo ================================================================
echo  DONE: %DATE% %TIME%
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:COPYREF
REM  %1 = condition name   %2 = source ctx dir
if exist "%KD%\ctx_%~1" goto :eof
if not exist "%~2" (
  echo [!] no reference %~2 - %~1 skipped
  goto :eof
)
mkdir "%KD%\ctx_%~1"
copy /y "%~2\test_details_rank*.json" "%KD%\ctx_%~1\" >nul
goto :eof

:CFEVAL
REM  %1 = orig300|drop300   %2 = condition   %3 = adapter dir   %4 = mode args   %5 = image mode
set CS=%~1
set CC=%~2
set CA=%~3
set CM=%~4
set CI=%~5
set CO=%CF%\%CS%\ctx_%CC%
if exist "%CO%\report.json" goto :eof
if not exist "%CA%\adapter_model.safetensors" (
  echo [!] cf %CS% %CC%: no adapter %CA% - skipped
  goto :eof
)
echo [%TIME%] CF EVAL %CS% %CC%  ^(log: %LOGDIR%\cf_%CS%_%CC%.log^)
%PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %CA% --model %MODEL% %CM% --dataset_root %CFD%\%CS% --data_dir FB15k-237 --eval_n 300 --eval_mode rank --cand_cap 50 --image_modes %CI% --output_dir %CO% --out %CO%\report.json > "%LOGDIR%\cf_%CS%_%CC%.log" 2>&1
echo [%TIME%] cf %CS% %CC% finished ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof

:PROBE
REM  %1 = label   %2 = adapter dir ("" = base model)
set PL=%~1
set PA=%~2
if not "%PA%"=="" if not exist "%PA%\adapter_model.safetensors" (
  echo [!] probe %PL%: no adapter %PA% - skipped
  goto :eof
)
set AARG=
if not "%PA%"=="" set AARG=--adapter %PA%
echo [%TIME%] PROBE %PL%  ^(log: %LOGDIR%\cf_probe_%PL%.log^)
%PYTHON% scripts\cf_read_probe.py run --label %PL% %AARG% --out %PROBE% > "%LOGDIR%\cf_probe_%PL%.log" 2>&1
echo [%TIME%] probe %PL% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof
