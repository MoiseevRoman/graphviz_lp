@echo off
REM ================================================================
REM  ROBUSTNESS CHECK FOR THE PAPER: main visual condition with the
REM  vision tower in bf16 (not 4-bit).
REM
REM  All paper runs used QLoRA with the WHOLE model in NF4, incl. the
REM  vision tower. In the path block (graphvis_ckpts_paths_iso) keeping
REM  the tower in bf16 made the model actually USE the image
REM  (real - blank: -0.011 -> +0.030 MRR). Text conditions do not use
REM  the tower, so 4-bit hits only the image. Here the paper's main
REM  'visual' condition is retrained for K = 4, 16, 8, 1 with the ONLY
REM  change --vision_bf16 (LM stays NF4; the loader FAILS if the tower
REM  is still 4-bit):
REM    data   graphvis_scaling\k<K>\datasets (same as the paper)
REM    train  4000 examples, 1 epoch, --train_vision, LoRA r=64,
REM           max_length default (1024), as graphvis_ckpts_scaling
REM    eval   rank, eval_n=1000 (the same 971 common-test queries as
REM           graphvis_ckpts_scaling_common), cand_cap=50,
REM           image real AND blank
REM  Old results are only COPIED (json) for comparison, never changed.
REM
REM  Output: graphvis_ckpts_scaling_vbf16\k<K>\
REM    ctx_visual_vbf16        new run (adapter + reports)
REM    ctx_visual_vbf16_blank  same adapter, blank image
REM    ctx_visual, ctx_text    copies of graphvis_ckpts_scaling_common
REM    compare.json          vs text (paper's question)
REM    compare_vs_nf4.json   vs the old NF4 visual adapter
REM    compare_blank.json    real vs blank image (is the image used)
REM  ~5 h per K (train ~1 h, each eval mode ~2 h). Finished K are
REM  skipped on re-run; if stopped after training, only the missing
REM  eval is redone from the saved adapter. K=4 and K=16 go
REM  first: if you stop early, the two key points are done.
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root:   run_main_vbf16.bat
REM  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set OUT=graphvis_ckpts_scaling_vbf16
set COMMON=graphvis_ckpts_scaling_common
set LOGDIR=%OUT%\logs
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo ================================================================
echo  MAIN VISUAL x VISION-BF16 START: %DATE% %TIME%
echo  python = %PYTHON%
echo  out    = %OUT%
echo ================================================================

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800
echo Baseline VRAM: %BASE% MiB  (between runs wait until below %THRESH% MiB)
echo.

call :RUNK 4
call :RUNK 16
call :RUNK 8
call :RUNK 1

echo.
echo ================ SUMMARY (per K, baseline = text) ================
for %%k in (4 16 8 1) do (
  if exist "%LOGDIR%\compare_k%%k.log" (
    echo ---------------- K=%%k ----------------
    type "%LOGDIR%\compare_k%%k.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"Saved" /c:"json"
    type "%LOGDIR%\compare_k%%k_vs_nf4.log" | findstr /l /c:"vs visual" /c:"MRR ="
    type "%LOGDIR%\compare_k%%k_blank.log" | findstr /l /c:"vs visual_vbf16_blank" /c:"MRR ="
  )
)

echo ================================================================
echo  DONE: %DATE% %TIME%
echo    reports: %OUT%\k^<K^>\ctx_visual_vbf16\report.json
echo    paired:  %OUT%\k^<K^>\compare.json  (logs: %LOGDIR%\compare_k^<K^>.log)
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:RUNK
REM  %1 = K
set K=%~1
set DS=graphvis_scaling\k%K%\datasets
set KD=%OUT%\k%K%
if not exist "%DS%\stage2_train" (
  echo [!] K=%K%: no dataset %DS% - skip
  goto :eof
)
if not exist "%KD%" mkdir "%KD%"

REM -- copies of the paper's common-test results (json only) --
for %%c in (text visual) do (
  if not exist "%KD%\ctx_%%c\report.json" if exist "%COMMON%\k%K%\ctx_%%c\report.json" (
    mkdir "%KD%\ctx_%%c" 2>nul
    copy /y "%COMMON%\k%K%\ctx_%%c\*.json" "%KD%\ctx_%%c\" >nul
  )
)

REM  resume logic: report.json = K finished. If the run was interrupted
REM  AFTER training (adapter saved), only the missing eval is redone.
set VD=%KD%\ctx_visual_vbf16
set ENV_ARGS=--model %MODEL% --context_mode visual --train_vision --vision_bf16 --dataset_root %DS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %VD%
if exist "%VD%\report.json" goto K_EVALDONE
if not exist "%VD%\adapter\adapter_model.safetensors" goto K_TRAIN
set IMS=real,blank
if exist "%VD%\test_details_rank.json" set IMS=blank
echo [%TIME%] K=%K%: adapter found - EVAL ONLY image_modes=!IMS!  ^(log: %LOGDIR%\eval_k%K%.log^)
%PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %VD%\adapter %ENV_ARGS% --image_modes "!IMS!" --out %VD%\report.json > "%LOGDIR%\eval_k%K%.log" 2>&1
echo [%TIME%] K=%K% eval done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto K_EVALDONE
:K_TRAIN
echo [%TIME%] K=%K%: TRAIN+EVAL visual --vision_bf16  ^(log: %LOGDIR%\train_k%K%.log^)
%PYTHON% scripts\viability_gate.py %ENV_ARGS% --train_n 4000 --epochs 1 --image_modes "real,blank" --out %VD%\report.json > "%LOGDIR%\train_k%K%.log" 2>&1
echo [%TIME%] K=%K% done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
:K_EVALDONE
if exist "%VD%\report.json" (
  echo [%TIME%] K=%K%: visual_vbf16 finished
) else (
  echo [!] K=%K%: no report.json - see logs, compare skipped
  goto :eof
)

if exist "%KD%\ctx_visual_vbf16\test_details_rank_blank.json" (
  if not exist "%KD%\ctx_visual_vbf16_blank" mkdir "%KD%\ctx_visual_vbf16_blank"
  copy /y "%KD%\ctx_visual_vbf16\test_details_rank_blank.json" "%KD%\ctx_visual_vbf16_blank\" >nul
)
REM  vs text (paper's question), vs old NF4 visual, real vs blank image
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions text,visual,visual_vbf16,visual_vbf16_blank --baseline text --out %KD%\compare.json > "%LOGDIR%\compare_k%K%.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual,visual_vbf16 --baseline visual --out %KD%\compare_vs_nf4.json > "%LOGDIR%\compare_k%K%_vs_nf4.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual_vbf16_blank,visual_vbf16 --baseline visual_vbf16_blank --out %KD%\compare_blank.json > "%LOGDIR%\compare_k%K%_blank.log" 2>&1
goto :eof
