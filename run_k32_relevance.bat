@echo off
REM ================================================================
REM  RELEVANCE-ENCODED STAR, K=32 @ 560 px (400 visual tokens).
REM  Why: visual K32 = none (MRR 0.379 @560, 0.386 @728) even when
REM  legible, while text K32 = text K16. Hypothesis: text lists the
REM  neighbors in hybrid-relevance order, the star shows 32 equal boxes.
REM  Fix: same neighbors, same size, but the style encodes the rank
REM  (--rel_tiers): top quarter orange + larger font + bold edge,
REM  second quarter as before, the rest small and grey; ordering="out".
REM
REM  Steps:
REM    1. build graphvis_rel\k32 (train+test 4000)   needs Neo4j
REM    2. Yes/No reading probe, base model (vs base_s560/K32 0.903)
REM    3. train + eval visual_vbf16_rel (rank, real)
REM    4. paired compare vs K32 visual 560/728, none, text, visual16
REM  Reading the result:
REM    rel > visual_vbf16 and rel > none   -> rank cue matters, the star
REM                                           was losing the ordering
REM    rel = visual_vbf16                  -> hypothesis rejected
REM
REM  Time ~4 h (build ~0.5, probe ~0.3, train ~1, eval ~2).
REM  Finished steps are skipped on re-run.
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root.  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set K=32
set SIZE=560
set /a MAXN=%K%+2
set RR=graphvis_rel\k%K%
set DS=%RR%\datasets
set KD=graphvis_ckpts_bigk\k%K%
set LOGDIR=graphvis_ckpts_bigk\logs
set RD=%KD%\ctx_visual_vbf16_rel
set PROBE=graphvis_readcheck\read_choice.json
if not exist "%LOGDIR%" mkdir "%LOGDIR%"
if not exist "%KD%\ctx_visual_vbf16\report.json" echo [!] no K32 visual baseline - run run_k32_readability.bat first

echo ================================================================
echo  K=32 RELEVANCE-TIERS RUN START: %DATE% %TIME%
echo ================================================================

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

REM ---------- 1. build ----------
if exist "%DS%\stage2_test\dataset_info.json" goto HAVEDS
%PYTHON% scripts\check_neo4j.py
if errorlevel 1 (
  echo [X] Neo4j is not reachable - start it and re-run.
  goto END
)
echo [%TIME%] BUILD K=%K% @ %SIZE% px, relevance tiers  ^(log: %LOGDIR%\build_k%K%_rel.log^)
%PYTHON% scripts\rerender_dataset.py --method hybrid --k %K% --target_size %SIZE% --max_nodes %MAXN% --rel_tiers --splits stage2_train,stage2_test --limit 4000 --workers 4 --out_root %RR% > "%LOGDIR%\build_k%K%_rel.log" 2>&1
echo [%TIME%] build done ^(code=!ERRORLEVEL!^)
if not exist "%DS%\stage2_test\dataset_info.json" (
  echo [X] build failed - see %LOGDIR%\build_k%K%_rel.log
  goto END
)
:HAVEDS

REM ---------- 2. reading probe (base model) ----------
echo [%TIME%] PROBE base on rel renders  ^(log: %LOGDIR%\probe_k%K%_rel.log^)
%PYTHON% scripts\read_choice_probe.py --k %K% --data_base graphvis_rel --max_nodes %MAXN% --label base_rel_s%SIZE% --out %PROBE% > "%LOGDIR%\probe_k%K%_rel.log" 2>&1
echo [%TIME%] probe done ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300

REM ---------- 3. train + eval ----------
set RARGS=--model %MODEL% --context_mode visual --train_vision --vision_bf16 --dataset_root %DS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %RD%
if exist "%RD%\report.json" (
  echo [%TIME%] visual_vbf16_rel: done - skip
  goto COMPARE
)
if exist "%RD%\adapter\adapter_model.safetensors" (
  echo [%TIME%] visual_vbf16_rel: adapter found - EVAL ONLY  ^(log: %LOGDIR%\eval_k%K%_visual_vbf16_rel.log^)
  %PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %RD%\adapter %RARGS% --image_modes real --out %RD%\report.json > "%LOGDIR%\eval_k%K%_visual_vbf16_rel.log" 2>&1
) else (
  echo [%TIME%] visual_vbf16_rel: TRAIN + EVAL  ^(log: %LOGDIR%\train_k%K%_visual_vbf16_rel.log^)
  %PYTHON% scripts\viability_gate.py %RARGS% --train_n 4000 --epochs 1 --image_modes real --out %RD%\report.json > "%LOGDIR%\train_k%K%_visual_vbf16_rel.log" 2>&1
)
echo [%TIME%] visual_vbf16_rel finished ^(code=!ERRORLEVEL!^)

REM ---------- 4. compare ----------
:COMPARE
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual_vbf16_rel,visual_vbf16,visual_vbf16_s728,none,text,visual16 --baseline visual_vbf16_rel --out %KD%\compare_rel.json > "%LOGDIR%\compare_k%K%_rel.log" 2>&1

echo.
echo ================ SUMMARY ================
type "%LOGDIR%\compare_k%K%_rel.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"[skip]" /c:"json"
echo.
%PYTHON% -c "import sys,json;sys.path.insert(0,'scripts');import read_choice_probe as r;r.print_table(json.load(open(r'%PROBE%',encoding='utf-8')))" | findstr /l /c:"K32" /c:"==="
:END
echo ================================================================
echo  DONE: %DATE% %TIME%
echo ================================================================
endlocal
pause
goto :EOF
