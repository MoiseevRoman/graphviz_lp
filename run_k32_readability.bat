@echo off
REM ================================================================
REM  DOES LOWER LEGIBILITY HURT LP?  K=32, 1-hop star, hybrid ranking.
REM  Same neighbors, two render sizes -> legibility is the ONLY variable:
REM    visual_vbf16       K32 @ 560 px  400 tok  node AUC 0.90 (base)
REM    visual_vbf16_s728  K32 @ 728 px  676 tok  node AUC 0.98 (base)
REM    text               K32 edge list ~429 tok (+ blank img as usual)
REM  Reference copies (json only): none, text16, visual16 (K=16 @ 560).
REM
REM  Paired comparisons (n=971 common queries):
REM    s728 vs 560        effect of legibility at equal information
REM    560  vs visual16   more neighbors but less legible
REM    text vs 560        ~equal token cost (400 vs ~429)
REM    text vs text16     do neighbors 17..32 carry signal at all?
REM
REM  Needs Neo4j running for the two build steps only.
REM  Time ~10-11 h (2 builds ~1 h, 3 trainings ~3 h, 3 evals ~6-7 h).
REM  Finished steps are skipped on re-run (safe to resume).
REM  Folders are compatible with run_bigk.bat (graphvis_scaling\k32,
REM  graphvis_ckpts_bigk\k32\ctx_visual_vbf16, ctx_text).
REM
REM  ASCII-only on purpose. Do NOT edit this file while it runs.
REM  RUN from repo root.  Override interpreter: set PYTHON=C:\...\python.exe
REM ================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"

if defined PYTHON goto PYSET
if not exist "..\myenv\Scripts\activate.bat" goto NOENV
call "..\myenv\Scripts\activate.bat"
echo myenv activated: ..\myenv
goto PYSET
:NOENV
echo [!] ..\myenv\Scripts\activate.bat not found - using python from PATH
:PYSET
if "%PYTHON%"=="" set PYTHON=python

set MODEL=Qwen/Qwen2.5-VL-3B-Instruct
set K=32
set OUT=graphvis_ckpts_bigk
set KD=%OUT%\k%K%
set LOGDIR=%OUT%\logs
set DS560=graphvis_scaling\k%K%\datasets
set DS728=graphvis_scaling\k%K%_s728\datasets
if not exist "%LOGDIR%" mkdir "%LOGDIR%"
if not exist "%KD%" mkdir "%KD%"

echo ================================================================
echo  K=32 LEGIBILITY RUN START: %DATE% %TIME%
echo  python = %PYTHON%
echo ================================================================

set BASE=0
for /f %%u in ('%PYTHON% scripts\gpu_mem.py --print') do set BASE=%%u
if not defined BASE set BASE=0
set /a THRESH=%BASE%+800

call :BUILD 560 graphvis_scaling\k%K%
call :BUILD 728 graphvis_scaling\k%K%_s728

call :COPYREF none graphvis_ckpts_s1\k16\ctx_none
call :COPYREF text16 graphvis_ckpts_scaling_common\k16\ctx_text
call :COPYREF visual16 graphvis_ckpts_scaling_vbf16\k16\ctx_visual_vbf16

call :RUN visual_vbf16 %DS560% "--context_mode visual --train_vision --vision_bf16"
call :RUN visual_vbf16_s728 %DS728% "--context_mode visual --train_vision --vision_bf16"
call :RUN text %DS560% "--context_mode text --train_vision --max_length 2048"

echo.
echo [%TIME%] COMPARE
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions visual_vbf16,visual_vbf16_s728,text,none,text16,visual16 --baseline visual_vbf16 --out %KD%\compare_legibility.json > "%LOGDIR%\compare_k32_legibility.log" 2>&1
%PYTHON% scripts\compare_conditions.py --ckpt_root %KD% --conditions text16,text --baseline text16 --out %KD%\compare_text16.json > "%LOGDIR%\compare_k32_text16.log" 2>&1

echo.
echo ================ SUMMARY ================
type "%LOGDIR%\compare_k32_legibility.log" | findstr /v /l /c:"[ok]" /c:"[protocol]" /c:"[skip]" /c:"json"
type "%LOGDIR%\compare_k32_text16.log" | findstr /l /c:"===" /c:"MRR ="
echo ================================================================
echo  DONE: %DATE% %TIME%
echo ================================================================
endlocal
pause
goto :EOF

REM ================================================================
REM  Subroutines
REM ================================================================
:BUILD
REM  %1 = render size px   %2 = out root
set BS=%~1
set BR=%~2
if exist "%BR%\datasets\stage2_test\dataset_info.json" goto :eof
%PYTHON% scripts\check_neo4j.py
if errorlevel 1 (
  echo [X] Neo4j is not reachable - start it and re-run. Build @ %BS% skipped.
  goto :eof
)
set /a MAXN=%K%+2
echo [%TIME%] BUILD K=%K% @ %BS% px  ^(log: %LOGDIR%\build_k%K%_s%BS%.log^)
%PYTHON% scripts\rerender_dataset.py --method hybrid --k %K% --target_size %BS% --max_nodes %MAXN% --splits stage2_train,stage2_test --limit 4000 --workers 4 --out_root %BR% > "%LOGDIR%\build_k%K%_s%BS%.log" 2>&1
echo [%TIME%] build done ^(code=!ERRORLEVEL!^)
if not exist "%BR%\datasets\stage2_test\dataset_info.json" echo [X] build @ %BS% failed - see log
goto :eof

:COPYREF
REM  %1 = condition name   %2 = source ctx dir
if exist "%KD%\ctx_%~1" goto :eof
if not exist "%~2" (
  echo [!] no reference %~2 - %~1 skipped
  goto :eof
)
mkdir "%KD%\ctx_%~1"
copy /y "%~2\test_details_rank*.json" "%KD%\ctx_%~1\" >nul
goto :eof

:RUN
REM  %1 = condition   %2 = dataset root   %3 = mode args
set RC=%~1
set RDS=%~2
set RA=%~3
set RD=%KD%\ctx_%RC%
if not exist "%RDS%\stage2_test\dataset_info.json" (
  echo [X] %RC%: no dataset %RDS% - skipped
  goto :eof
)
set RARGS=--model %MODEL% %RA% --dataset_root %RDS% --data_dir FB15k-237 --eval_n 1000 --eval_mode rank --cand_cap 50 --output_dir %RD%
if exist "%RD%\report.json" (
  echo [%TIME%] %RC%: done - skip
  goto :eof
)
if exist "%RD%\adapter\adapter_model.safetensors" (
  echo [%TIME%] %RC%: adapter found - EVAL ONLY  ^(log: %LOGDIR%\eval_k%K%_%RC%.log^)
  %PYTHON% scripts\viability_gate.py --eval_only --adapter_dir %RD%\adapter %RARGS% --image_modes real --out %RD%\report.json > "%LOGDIR%\eval_k%K%_%RC%.log" 2>&1
) else (
  echo [%TIME%] %RC%: TRAIN + EVAL  ^(log: %LOGDIR%\train_k%K%_%RC%.log^)
  %PYTHON% scripts\viability_gate.py %RARGS% --train_n 4000 --epochs 1 --image_modes real --out %RD%\report.json > "%LOGDIR%\train_k%K%_%RC%.log" 2>&1
)
echo [%TIME%] %RC% finished ^(code=!ERRORLEVEL!^)
%PYTHON% scripts\gpu_mem.py --wait --below %THRESH% --timeout 300
goto :eof
